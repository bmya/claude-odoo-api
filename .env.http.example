# HTTP transport — server-level configuration (NO Odoo credentials here)
#
# In HTTP mode the server stores no Odoo credentials. Each request carries a BMYA
# API key (X-Bmya-Api-Key), which resolves server-side to the Odoo URL and
# database, plus the user's own personal Odoo API key (X-Odoo-Api-Key).
# See docs/remote-client-config.md and docs/bmya-api-keys.md.
#
# For the actual bmya.cloud deployment use deploy/.env.example instead: this file
# documents the variables the server itself reads.

# Transport selector
MCP_TRANSPORT=http

# Bind address / port / mount path
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8080
MCP_HTTP_PATH=/mcp

# TLS: set BOTH to serve HTTPS directly (e.g. self-signed for local tests).
# Leave empty when TLS is terminated by a reverse proxy and the hop to this
# server is a private network; the app honours X-Forwarded-Proto.
MCP_TLS_CERTFILE=
MCP_TLS_KEYFILE=

# Client IPs trusted to set X-Forwarded-*. Defaults to 127.0.0.1. Set it to the
# reverse proxy's address; "*" lets anyone who reaches the port forge those
# headers, so avoid it.
MCP_FORWARDED_ALLOW_IPS=127.0.0.1

# --- BMYA per-database authorization ----------------------------------------

# 1 = require a valid X-Bmya-Api-Key on every request (normal).
# 0 = rollback: clients supply X-Odoo-Url/X-Odoo-Database themselves, with no
#     per-database authorization. Migration only.
BMYA_AUTH_ENABLED=1

# Where grants are read from. Only "file" is implemented; this is the seam for
# validating keys against www.bmya.cl in a later phase.
BMYA_KEYS_BACKEND=file

# The key registry: maps sha256(key) -> Odoo URL + database + mode.
BMYA_API_KEYS_FILE=/app/config/bmya-api-keys.json

# How long a loaded registry is trusted before the file is re-checked. Also the
# worst-case delay before a revocation takes effect. SIGHUP reloads immediately.
BMYA_REGISTRY_TTL_SECONDS=10

# Refuse to load any grant whose Odoo URL host is outside these suffixes.
# Empty = no suffix restriction (https and public-IP checks still apply).
BMYA_ALLOWED_URL_SUFFIXES=.bmya.cloud,.bmya.cl

# Local development only: allows http:// and private/loopback addresses in a
# grant's odoo_url. Never set this in production.
BMYA_ALLOW_INSECURE_URLS=

# --- Other guardrails -------------------------------------------------------

# Optional reconfigurable "front door" on top of the per-database keys: when set,
# requests must also carry a matching X-Gateway-Token header.
MCP_GATEWAY_TOKEN=

# Server-wide ceiling over every grant: with this on, even a readwrite key is
# read-only. The effective mode is the most restrictive of this, the grant, and
# the client's optional X-Odoo-Mode.
ODOO_MCP_READONLY=1

# Global allowlist for odoo_call_method ("model.method,..."). A grant's own
# allowed_methods is intersected with this, so a grant can only narrow it.
ODOO_MCP_ALLOWED_METHODS=

ODOO_REQUEST_TIMEOUT=30
ODOO_MAX_RETRIES=3

# Max number of cached per-credential Odoo clients (bounded LRU).
ODOO_CLIENT_CACHE_MAX=256
