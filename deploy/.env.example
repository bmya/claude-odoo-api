# Deployment settings for deploy/docker-compose.yml.
# Copy to deploy/.env and edit. NO Odoo credentials belong here: those live in
# the BMYA key registry (per database) and in each user's own MCP client config.

# --- Image / build -----------------------------------------------------------
# Prebuilt multi-arch image (published on tag by .github/workflows/release.yml).
# Ignored when you run `docker compose up --build` to build on the server.
MCP_IMAGE=ghcr.io/bmya/odoo-mcp-server:latest

# --- Network ----------------------------------------------------------------
# VLAN address of THIS host: the only interface the backend port is published on.
# Traefik runs on a separate host and connects to http://<MCP_BIND_ADDR>:8080.
MCP_BIND_ADDR=10.0.0.14
MCP_HTTP_PORT=8080

# VLAN address of the Traefik host: the only client trusted to set
# X-Forwarded-For / X-Forwarded-Proto.
TRAEFIK_HOST_IP=10.0.0.1

# --- BMYA key registry ------------------------------------------------------
# Host DIRECTORY holding bmya-api-keys.json, mounted read-only at /app/config.
# It must be the directory, not the file: a single-file bind mount pins the inode,
# so an atomically-rewritten registry would stay invisible inside the container
# and revocations would never take effect.
# Ownership matters: bind mounts keep host uids and the container runs as uid
# 1000, so run:  sudo chown -R 1000:1000 config && sudo chmod 600 config/bmya-api-keys.json
BMYA_KEYS_HOST_DIR=./config

# 1 = enforce per-database keys (normal). 0 = rollback to the old behaviour where
# clients supply X-Odoo-Url/X-Odoo-Database themselves. Deploy with 0 only while
# migrating client configs, then set it back to 1.
BMYA_AUTH_ENABLED=1

# How long a loaded registry is trusted before the file is re-checked. This is
# also the worst-case delay before a revocation takes effect.
BMYA_REGISTRY_TTL_SECONDS=10

# Refuse to load any grant pointing outside our own domains.
BMYA_ALLOWED_URL_SUFFIXES=.bmya.cloud,.bmya.cl

# --- Guardrails -------------------------------------------------------------
# Server-wide ceiling over every grant. Keep at 1 while the deployment is
# read-only; a readwrite key does nothing until this is set to 0.
ODOO_MCP_READONLY=1

# Global allowlist for odoo_call_method ("model.method,model.method"). A grant's
# own allowed_methods is intersected with this, so it can only narrow it.
# Empty = fall back to the three built-in defaults.
ODOO_MCP_ALLOWED_METHODS=

# Optional shared "front door" token on top of the per-database keys, as an
# extra header every client must send. Leave empty to rely on the keys alone.
MCP_GATEWAY_TOKEN=

# --- Only used in the docs, not by compose ----------------------------------
# Public hostname clients point at (served by the Traefik host).
# DOMAIN=odoo-mcp.bmya.cloud
