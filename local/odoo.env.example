# Config of the local MCP (mcp-odoo-local). Copy to local/odoo.env (gitignored).
# Mounted as a DIRECTORY (local/ -> /app/local), never as a single file: editors
# save by rename, and a single-file bind mount would keep the old inode, so
# edits would never reach the container. The server re-reads it on change.

# [DEFAULT] is the local instance. Any database it lists (within its dbfilter)
# is usable by name as the tools' 'company' argument, with no section of its
# own: databases cloned from the template carry the same API key.
# Every section below inherits these values, so keep only local instances here.
[DEFAULT]
# From Docker Desktop the host is host.docker.internal (localhost when run natively).
ODOO_URL=http://host.docker.internal:8369
# API key of admin in the template database, scope "RPC", persistent.
ODOO_API_KEY=replace-me
ODOO_LOGIN=admin
# admin_passwd of the Odoo server; needed only by odoo_duplicate_database.
ODOO_MASTER_PASSWORD=replace-me
# readwrite (default) or readonly, per section.
ODOO_MODE=readwrite

# The template stays pristine: writes are refused, also when named by database.
[template_cl]
ODOO_DATABASE=odoo20e_template_cl
ODOO_MODE=readonly

# Optional short aliases for demos:
# [clientex]
# ODOO_DATABASE=odoo20e_demo_clientex
